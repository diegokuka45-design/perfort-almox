  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nexport default function App() {\n  return <div></div>;\n}"
      replacement_content: "import { useState, useEffect } from \'react\';\nimport { motion } from \'motion/react\';\nimport { \n  CheckCircle2, \n  RotateCcw, \n  Plus, \n  Minus, \n  Sparkles, \n  Zap, \n  Clock, \n  Monitor, \n  HardDrive, \n  Activity,\n  Palette,\n  Terminal\n} from \'lucide-react\';\n\nexport default function App() {\n  const [count, setCount] = useState<number>(0);\n  const [testInput, setTestInput] = useState<string>(\'Teste de Sistema OK\');\n  const [activeTheme, setActiveTheme] = useState<\'emerald\' | \'indigo\' | \'amber\'>(\'emerald\');\n  const [windowDimensions, setWindowDimensions] = useState({\n    width: typeof window !== \'undefined\' ? window.innerWidth : 0,\n    height: typeof window !== \'undefined\' ? window.innerHeight : 0,\n  });\n  const [pingMs, setPingMs] = useState<number | null>(null);\n  const [logs, setLogs] = useState<Array<{ id: number; message: string; time: string }>>([\n    { id: 1, message: \'Aplica\303\247\303\243o inicializada com sucesso\', time: new Date().toLocaleTimeString() }\n  ]);\n\n  useEffect(() => {\n    const handleResize = () => {\n      setWindowDimensions({\n        width: window.innerWidth,\n        height: window.innerHeight,\n      });\n    };\n    window.addEventListener(\'resize\', handleResize);\n    return () => window.removeEventListener(\'resize\', handleResize);\n  }, []);\n\n  const addLog = (msg: string) => {\n    const newLog = {\n      id: Date.now(),\n      message: msg,\n      time: new Date().toLocaleTimeString(),\n    };\n    setLogs((prev) => [newLog, ...prev.slice(0, 9)]);\n  };\n\n  const measureLatency = () => {\n    const start = performance.now();\n    setTimeout(() => {\n      const duration = Math.round(performance.now() - start);\n      setPingMs(duration);\n      addLog(`Teste de lat\303\252ncia de evento: ${duration}ms`);\n    }, 50);\n  };\n\n  const handleIncrement = () => {\n    setCount((prev) => {\n      const next = prev + 1;\n      addLog(`Contador incrementado para ${next}`);\n      return next;\n    });\n  };\n\n  const handleDecrement = () => {\n    setCount((prev) => {\n      const next = prev - 1;\n      addLog(`Contador decrementado para ${next}`);\n      return next;\n    });\n  };\n\n  const handleReset = () => {\n    setCount(0);\n    addLog(\'Contador resetado para 0\');\n  };\n\n  const themeColors = {\n    emerald: {\n      accent: \'bg-emerald-600 hover:bg-emerald-700 text-white\',\n      badge: \'bg-emerald-50 text-emerald-700 border-emerald-200\',\n      ring: \'focus:ring-emerald-500\',\n      activeBorder: \'border-emerald-500\',\n    },\n    indigo: {\n      accent: \'bg-indigo-600 hover:bg-indigo-700 text-white\',\n      badge: \'bg-indigo-50 text-indigo-700 border-indigo-200\',\n      ring: \'focus:ring-indigo-500\',\n      activeBorder: \'border-indigo-500\',\n    },\n    amber: {\n      accent: \'bg-amber-600 hover:bg-amber-700 text-white\',\n      badge: \'bg-amber-50 text-amber-700 border-amber-200\',\n      ring: \'focus:ring-amber-500\',\n      activeBorder: \'border-amber-500\',\n    },\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900 font-sans p-4 md:p-8\">\n      <div className=\"max-w-4xl mx-auto space-y-6\">\n        \n        {/* Header */}\n        <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-xs\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"p-3 bg-slate-900 text-white rounded-xl\">\n              <Activity className=\"w-6 h-6\" />\n            </div>\n            <div>\n              <h1 className=\"text-xl font-semibold text-slate-900 tracking-tight\">Painel de Teste de Aplica\303\247\303\243o</h1>\n              <p className=\"text-sm text-slate-500\">Verifica\303\247\303\243o de estado, interatividade e desempenho</p>\n            </div>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200\">\n              <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\"></span>\n              Sistema Operacional\n            </span>\n          </div>\n        </header>\n\n        {/* System Info Grid */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n          <div className=\"bg-white p-4 rounded-xl border border-slate-200 flex items-center gap-3\">\n            <Monitor className=\"w-5 h-5 text-slate-400\" />\n            <div>\n              <p className=\"text-xs text-slate-500\">Resolu\303\247\303\243o do Display</p>\n              <p className=\"text-sm font-medium text-slate-800\">{windowDimensions.width} x {windowDimensions.height} px</p>\n            </div>\n          </div>\n\n          <div className=\"bg-white p-4 rounded-xl border border-slate-200 flex items-center gap-3\">\n            <HardDrive className=\"w-5 h-5 text-slate-400\" />\n            <div>\n              <p className=\"text-xs text-slate-500\">Armazenamento Local</p>\n              <p className=\"text-sm font-medium text-slate-800\">\n                {typeof window !== \'undefined\' && window.localStorage ? \'Dispon\303\255vel\' : \'Indispon\303\255vel\'}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"bg-white p-4 rounded-xl border border-slate-200 flex items-center gap-3\">\n            <Clock className=\"w-5 h-5 text-slate-400\" />\n            <div>\n              <p className=\"text-xs text-slate-500\">Lat\303\252ncia do Event Loop</p>\n              <p className=\"text-sm font-medium text-slate-800\">\n                {pingMs !== null ? `${pingMs} ms` : \'N\303\243o medido\'}\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {/* Interactive Testing Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          \n          {/* State & Counter Test */}\n          <div className=\"bg-white p-6 rounded-2xl border border-slate-200 space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <h2 className=\"text-base font-semibold text-slate-900 flex items-center gap-2\">\n                <Zap className=\"w-4 h-4 text-slate-600\" />\n                Teste de Estado (Counter)\n              </h2>\n              <span className=\"text-xs text-slate-500\">React State</span>\n            </div>\n\n            <div className=\"py-6 flex flex-col items-center justify-center bg-slate-50 rounded-xl border border-slate-100\">\n              <motion.span \n                key={count}\n                initial={{ scale: 0.8, opacity: 0 }}\n                animate={{ scale: 1, opacity: 1 }}\n                className=\"text-4xl font-bold text-slate-900 font-mono\"\n              >\n                {count}\n              </motion.span>\n              <span className=\"text-xs text-slate-400 mt-1\">Valor Atual</span>\n            </div>\n\n            <div className=\"flex items-center gap-2\">\n              <button\n                onClick={handleDecrement}\n                className=\"flex-1 py-2 px-3 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-lg text-sm font-medium flex items-center justify-center gap-1 transition-colors\"\n              >\n                <Minus className=\"w-4 h-4\" /> Diminuir\n              </button>\n              <button\n                onClick={handleIncrement}\n                className={`flex-1 py-2 px-3 ${themeColors[activeTheme].accent} rounded-lg text-sm font-medium flex items-center justify-center gap-1 transition-colors`}\n              >\n                <Plus className=\"w-4 h-4\" /> Aumentar\n              </button>\n              <button\n                onClick={handleReset}\n                className=\"py-2 px-3 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg text-sm font-medium flex items-center justify-center transition-colors\"\n                title=\"Resetar\"\n              >\n                <RotateCcw className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n\n          {/* Input & Echo Test */}\n          <div className=\"bg-white p-6 rounded-2xl border border-slate-200 space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <h2 className=\"text-base font-semibold text-slate-900 flex items-center gap-2\">\n                <Sparkles className=\"w-4 h-4 text-slate-600\" />\n                Teste de Entrada de Texto\n              </h2>\n              <span className=\"text-xs text-slate-500\">Two-way Binding</span>\n            </div>\n\n            <div className=\"space-y-3\">\n              <label className=\"block text-xs font-medium text-slate-600\">Digita\303\247\303\243o Interativa</label>\n              <input\n                type=\"text\"\n                value={testInput}\n                onChange={(e) => {\n                  setTestInput(e.target.value);\n                  addLog(`Input alterado: \"${e.target.value}\"`);\n                }}\n                className={`w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-900 focus:outline-none focus:ring-2 ${themeColors[activeTheme].ring}`}\n                placeholder=\"Digite algo para testar...\"\n              />\n            </div>\n\n            <div className=\"p-3 bg-slate-50 rounded-xl border border-slate-100\">\n              <p className=\"text-xs text-slate-400 mb-1\">Eco da Mensagem:</p>\n              <p className=\"text-sm font-medium text-slate-800 break-words\">\n                {testInput || <span className=\"text-slate-400 italic\">Vazio</span>}\n              </p>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Theme & Performance Controls */}\n        <div className=\"bg-white p-6 rounded-2xl border border-slate-200 space-y-4\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n            <div>\n              <h2 className=\"text-base font-semibold text-slate-900 flex items-center gap-2\">\n                <Palette className=\"w-4 h-4 text-slate-600\" />\n                Personaliza\303\247\303\243o de Tema & Teste de Diagn\303\263stico\n              </h2>\n              <p className=\"text-xs text-slate-500\">Alterne paletas e execute testes de tempo de resposta</p>\n            </div>\n\n            <div className=\"flex items-center gap-3\">\n              <div className=\"flex items-center gap-1.5 p-1 bg-slate-100 rounded-lg\">\n                {([\'emerald\', \'indigo\', \'amber\'] as const).map((t) => (\n                  <button\n                    key={t}\n                    onClick={() => {\n                      setActiveTheme(t);\n                      addLog(`Tema alterado para ${t}`);\n                    }}\n                    className={`px-3 py-1 text-xs font-medium rounded-md capitalize transition-all ${\n                      activeTheme === t ? \'bg-white text-slate-900 shadow-xs\' : \'text-slate-600 hover:text-slate-900\'\n                    }`}\n                  >\n                    {t}\n                  </button>\n                ))}\n              </div>\n\n              <button\n                onClick={measureLatency}\n                className=\"py-1.5 px-3 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-xs font-medium flex items-center gap-1.5 transition-colors\"\n              >\n                Medir Lat\303\252ncia\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Event Logs */}\n        <div className=\"bg-white p-6 rounded-2xl border border-slate-200 space-y-3\">\n          <div className=\"flex items-center justify-between\">\n            <h2 className=\"text-base font-semibold text-slate-900 flex items-center gap-2\">\n              <Terminal className=\"w-4 h-4 text-slate-600\" />\n              Hist\303\263rico de Eventos do Teste\n            </h2>\n            <button \n              onClick={() => setLogs([])}\n              className=\"text-xs text-slate-400 hover:text-slate-600 transition-colors\"\n            >\n              Limpar Logs\n            </button>\n          </div>\n\n          <div className=\"bg-slate-950 p-4 rounded-xl font-mono text-xs text-slate-300 space-y-2 max-h-48 overflow-y-auto\">\n            {logs.length === 0 ? (\n              <p className=\"text-slate-600 italic\">Nenhum evento registrado.</p>\n            ) : (\n              logs.map((log) => (\n                <div key={log.id} className=\"flex items-start gap-2\">\n                  <span className=\"text-slate-500\">[{log.time}]</span>\n                  <span className=\"text-emerald-400\">\342\206\222</span>\n                  <span className=\"text-slate-200\">{log.message}</span>\n                </div>\n              ))\n            )}\n          </div>\n        </div>\n\n        {/* Footer */}\n        <footer className=\"text-center text-xs text-slate-400 py-2\">\n          App de Teste \342\200\242 React 19 & Tailwind CSS \342\200\242 Estado e componentes em execu\303\247\303\243o normal\n        </footer>\n\n      </div>\n    </div>\n  );\n}\n"
    }
