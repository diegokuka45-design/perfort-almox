        }
        lines {
          text: "  return `### \360\237\223\212 An\303\241lise de Estoque e Desempenho \342\200\224 PERFORT ENGENHARIA"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Resumo Executivo do Almoxarifado:**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Status Geral:** O estoque encontra-se operacional, por\303\251m com **2 itens em n\303\255vel CR\303\215TICO** e **1 em n\303\255vel BAIXO**."
