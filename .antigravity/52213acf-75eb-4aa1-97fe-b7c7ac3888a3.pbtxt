        }
        lines {
          text: "   - *Perda Estimada:* 4.2% em retalhos inferiores a 50cm."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - *Recomenda\303\247\303\243o:* Centralizar o corte e dobra na bancada de arma\303\247\303\243o para reaproveitamento de pontas em caranguejos e espa\303\247adores."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
