        }
        lines {
          text: "export function getStatus(item: ItemInsumo): \'OK\' | \'BAIXO\' | \'CR\303\215TICO\' {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const saldo = getSaldo(item);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const min = item.estoque_min || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (saldo <= 0) return \'CR\303\215TICO\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (saldo <= min) return \'BAIXO\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return \'OK\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
