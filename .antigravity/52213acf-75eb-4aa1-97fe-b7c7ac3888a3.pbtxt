        }
        lines {
          text: "      const saldoAnterior = getSaldo(item) - entrada.qtd;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const valAnterior = saldoAnterior > 0 ? (item.preco_medio || 0) * saldoAnterior : 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const novoTotalQtd = Math.max(1, saldoAnterior + entrada.qtd);"
