tring;\n  detail: string;\n  obra: string;\n}\n\nexport interface BackupSnapshot {\n  name: string;\n  timestamp: string;\n  size: number;\n  data: string;\n}\n\nexport interface IAMessage {\n  role: \'user\' | \'model\';\n  text: string;\n  image?: string | null;\n  timestamp?: string;\n}\n"
