        lines {
          text: "export function getSaldo(item: ItemInsumo): number {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const init = item.quantidade || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const ent = item.entradas_total || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const sai = item.saidas_total || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return init + ent - sai;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
