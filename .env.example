# ============================================================================
# Perfort Almox — Firebase Configuration
# ============================================================================
# Copie este arquivo para .env.local e preencha com os dados do seu projeto Firebase.
# NUNCA commite o arquivo .env.local real no repositório.
# ============================================================================

# Firebase Project
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Opcional: Firebase Realtime Database URL (se usar RTDB)
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Opcional: Measurement ID (Google Analytics)
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
