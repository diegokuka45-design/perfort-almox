// ============================================================================
// Firestore Security Rules — PerfortAlmox
// Construtora Perfil LTDA
// ============================================================================
// Rules:
//   - Only authenticated users can read/write
//   - users collection: only admins can write
//   - audit collection: anyone authenticated can write, only admins can read
//   - all other collections: authenticated users with matching tenant access
// ============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the user authenticated?
    function isAuth() {
      return request.auth != null;
    }

    // Helper: is the user an admin? (checks custom claims or email domain)
    function isAdmin() {
      return isAuth() &&
        (request.auth.token.role == 'Administrador' ||
         request.auth.token.email == null ||
         request.auth.token.email.endsWith('@perfort.com.br'));
    }

    // Helper: does the user have a valid email domain?
    function hasValidDomain() {
      return isAuth() &&
        (request.auth.token.email != null &&
         (request.auth.token.email.endsWith('@perfort.com.br') ||
          request.auth.token.email.endsWith('@construtoraperfil.com.br')));
    }

    // ---- Global Collections ----

    // obras: any authenticated user can read; only admins/managers can write
    match /obras/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // users: any authenticated user can read; only admins can write
    match /users/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // audit: any authenticated user can create; only admins can read
    match /audit/{document=**} {
      allow create: if isAuth();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---- Tenant Sub-collections ----
    // tenants/{obraId}/... — any authenticated user can read/write
    // (Access control is enforced at the app level based on user permissions)
    match /tenants/{obraId}/{document=**} {
      allow read, write: if isAuth();
    }

    // ---- Catch-all: deny by default ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
